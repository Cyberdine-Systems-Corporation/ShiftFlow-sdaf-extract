@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using ShiftFlow.Application.Auth
@using ShiftFlow.Web.Auth
@inject IHttpClientFactory HttpClientFactory
@inject ApiAuthenticationStateProvider AuthState
@inject CookieContainerHolder CookieJar
@inject NavigationManager Navigation

<header class="sf-nav" role="banner">
    <div class="sf-nav-inner">
        <a class="sf-brand" href="/">ShiftFlow</a>
        <nav class="sf-nav-links" aria-label="Principal">
            <AuthorizeView Roles="@AuthRoles.Administrator">
                <Authorized>
                    <NavLink class="sf-nav-link" href="/organizations" Match="NavLinkMatch.Prefix">Organizaciones</NavLink>
                    <NavLink class="sf-nav-link" href="/calendar">Calendario</NavLink>
                    <span class="sf-nav-user">@context.User.Identity?.Name</span>
                    <button type="button" class="sf-btn sf-btn-ghost sf-btn-sm" @onclick="LogoutAsync">Salir</button>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="sf-nav-link" href="/login">Entrar</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

@code {
    private async Task LogoutAsync()
    {
        var client = HttpClientFactory.CreateClient("api");
        await client.PostAsync("/api/auth/logout", null);
        CookieJar.Clear();
        AuthState.NotifyChanged();
        Navigation.NavigateTo("/login");
    }
}
