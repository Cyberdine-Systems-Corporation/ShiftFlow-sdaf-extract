@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using ShiftFlow.Application.Auth
@inject IHttpClientFactory HttpClientFactory

<PageTitle>ShiftFlow</PageTitle>

<section class="sf-hero">
    <p class="sf-hero-brand" aria-hidden="true">ShiftFlow</p>
    <h1>Planificación de turnos con reglas visibles y demo local.</h1>
    <p class="sf-lede">
        Configura el núcleo (organización, departamentos, empleados y tipos de turno)
        y prepárate para asignar turnos en el calendario mensual.
    </p>

    <div class="sf-status-row" aria-live="polite">
        @if (_apiStatus is null && _error is null)
        {
            <span class="sf-badge sf-badge-muted">Comprobando API…</span>
        }
        else if (_error is not null)
        {
            <span class="sf-badge sf-badge-danger">API no disponible</span>
            <span class="sf-hint">@_error</span>
        }
        else
        {
            <span class="sf-badge">API lista</span>
        }
    </div>

    <AuthorizeView Roles="@AuthRoles.Administrator">
        <Authorized>
            <div class="sf-cta-row">
                <a class="sf-btn sf-btn-primary" href="/organizations">Ir a organizaciones</a>
                <a class="sf-btn sf-btn-secondary" href="/calendar">Calendario</a>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="sf-cta-row">
                <a class="sf-btn sf-btn-primary" href="/login">Iniciar sesión</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</section>

@code {
    private string? _apiStatus;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("api");
            using var response = await client.GetAsync("/api/status");
            response.EnsureSuccessStatusCode();
            _apiStatus = "ok";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
