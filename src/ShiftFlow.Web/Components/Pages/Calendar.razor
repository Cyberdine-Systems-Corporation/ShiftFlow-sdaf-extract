@page "/calendar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = AuthRoles.Administrator)]
@using ShiftFlow.Application.Auth

<PageTitle>Calendario — ShiftFlow</PageTitle>

<section class="sf-placeholder">
    <span class="sf-badge sf-badge-muted">Sprint 2</span>
    <h1 class="sf-page-title">Calendario</h1>
    <p class="sf-lede">
        La vista mensual y la asignación de turnos llegan con PBI-005 y el Rule Engine.
        El shell de navegación ya está listo para el journey demo.
    </p>
    <div class="sf-cta-row">
        <a class="sf-btn sf-btn-primary" href="/organizations">Ir a maestros</a>
        <a class="sf-btn sf-btn-secondary" href="/">Volver al inicio</a>
    </div>
</section>
