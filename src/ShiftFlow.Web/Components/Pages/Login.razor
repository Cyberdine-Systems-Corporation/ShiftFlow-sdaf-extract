@page "/login"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using ShiftFlow.Application.Auth
@using ShiftFlow.Web.Auth
@inject IHttpClientFactory HttpClientFactory
@inject ApiAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Login — ShiftFlow</PageTitle>

<h1>Iniciar sesión</h1>
<p>Usuario demo: <code>@DemoCredentials.UserName</code> (ver runbook para la contraseña).</p>

@if (!string.IsNullOrEmpty(_error))
{
    <p class="auth-error">@_error</p>
}

<EditForm Model="_model" OnSubmit="OnLoginAsync">
    <div class="auth-field">
        <label>Usuario</label>
        <InputText @bind-Value="_model.UserName" />
    </div>
    <div class="auth-field">
        <label>Contraseña</label>
        <InputText type="password" @bind-Value="_model.Password" />
    </div>
    <button type="submit" disabled="@_busy">Entrar</button>
</EditForm>

@code {
    private readonly LoginModel _model = new() { UserName = DemoCredentials.UserName };
    private string? _error;
    private bool _busy;

    private async Task OnLoginAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var client = HttpClientFactory.CreateClient("api");
            using var response = await client.PostAsJsonAsync("/api/auth/login", new
            {
                userName = _model.UserName,
                password = _model.Password
            });

            if (!response.IsSuccessStatusCode)
            {
                _error = "Credenciales inválidas.";
                return;
            }

            AuthState.NotifyChanged();
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class LoginModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
