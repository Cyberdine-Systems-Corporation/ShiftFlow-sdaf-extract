@page "/organizations"
@rendermode InteractiveServer
@attribute [Authorize(Roles = AuthRoles.Administrator)]
@using ShiftFlow.Application.Auth
@using ShiftFlow.Application.Organizations
@using ShiftFlow.Web.Api
@inject MastersApiClient Api
@inject CookieContainerHolder Session
@inject NavigationManager Navigation

<PageTitle>Organizaciones — ShiftFlow</PageTitle>

<h1 class="sf-page-title">Organizaciones</h1>
<p class="sf-lede">Maestros del núcleo (AC-01). Abre una organización para departamentos, empleados y tipos de turno.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <p class="sf-alert" role="alert">@_error</p>
}

<section class="sf-section">
    <h2>Nueva organización</h2>
    <div class="sf-field">
        <label for="org-name">Nombre</label>
        <InputText id="org-name" @bind-Value="_newName" />
    </div>
    <div class="sf-actions">
        <button type="button" class="sf-btn sf-btn-primary" disabled="@_busy" @onclick="CreateAsync">
            @(_busy ? "Creando…" : "Crear organización")
        </button>
    </div>
</section>

<section class="sf-section">
    <div class="sf-section-head">
        <h2>Listado</h2>
        @if (_items is not null)
        {
            <span class="sf-badge sf-badge-muted">@_items.Count</span>
        }
    </div>

    @if (_items is null)
    {
        <p class="sf-hint">Cargando organizaciones…</p>
    }
    else if (_items.Count == 0)
    {
        <div class="sf-empty">
            <strong>Aún no hay organizaciones</strong>
            Crea la primera con el formulario de arriba para empezar el journey demo.
        </div>
    }
    else
    {
        <table class="sf-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var org in _items)
                {
                    <tr>
                        <td>@org.Name</td>
                        <td>
                            @if (org.IsActive)
                            {
                                <span class="sf-badge">Activa</span>
                            }
                            else
                            {
                                <span class="sf-badge sf-badge-muted">Inactiva</span>
                            }
                        </td>
                        <td>
                            <a class="sf-btn sf-btn-ghost sf-btn-sm" href="@($"/organizations/{org.Id}")">Abrir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private IReadOnlyList<OrganizationDto>? _items;
    private string _newName = string.Empty;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _error = null;
        try
        {
            _items = await Api.ListOrganizationsAsync();
        }
        catch (Exception ex)
        {
            var authHint = string.IsNullOrWhiteSpace(Session.AccessToken)
                ? "sin sesión Bearer"
                : "con sesión Bearer";
            _error = $"No se pudo cargar el listado: {ex.Message} ({authHint}).";
            _items = [];
        }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.CreateOrganizationAsync(_newName);
            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _newName = string.Empty;
            Navigation.NavigateTo($"/organizations/{result.Value!.Id}");
        }
        finally
        {
            _busy = false;
        }
    }
}
