@page "/organizations"
@rendermode InteractiveServer
@attribute [Authorize(Roles = AuthRoles.Administrator)]
@using ShiftFlow.Application.Auth
@using ShiftFlow.Application.Organizations
@using ShiftFlow.Web.Api
@inject MastersApiClient Api
@inject CookieContainerHolder Session
@inject NavigationManager Navigation

<PageTitle>Organizaciones — ShiftFlow</PageTitle>

<h1>Organizaciones</h1>
<p>Maestros del núcleo (AC-01). Selecciona una organización para departamentos, empleados y tipos de turno.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <p class="auth-error">@_error</p>
}

<section class="panel">
    <h2>Nueva organización</h2>
    <div class="auth-field">
        <label>Nombre</label>
        <InputText @bind-Value="_newName" />
    </div>
    <button type="button" disabled="@_busy" @onclick="CreateAsync">Crear</button>
</section>

<section class="panel">
    <h2>Listado</h2>
    @if (_items is null)
    {
        <p>Cargando…</p>
    }
    else if (_items.Count == 0)
    {
        <p>No hay organizaciones. Crea la primera.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Activa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var org in _items)
                {
                    <tr>
                        <td>@org.Name</td>
                        <td>@(org.IsActive ? "Sí" : "No")</td>
                        <td><a href="@($"/organizations/{org.Id}")">Abrir</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private IReadOnlyList<OrganizationDto>? _items;
    private string _newName = string.Empty;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _error = null;
        try
        {
            _items = await Api.ListOrganizationsAsync();
        }
        catch (Exception ex)
        {
            var authHint = string.IsNullOrWhiteSpace(Session.AccessToken)
                ? "sin Bearer"
                : "con Bearer";
            _error = $"{ex.Message} ({authHint}, cookies={Session.Count})";
            _items = [];
        }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.CreateOrganizationAsync(_newName);
            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            _newName = string.Empty;
            Navigation.NavigateTo($"/organizations/{result.Value!.Id}");
        }
        finally
        {
            _busy = false;
        }
    }
}
