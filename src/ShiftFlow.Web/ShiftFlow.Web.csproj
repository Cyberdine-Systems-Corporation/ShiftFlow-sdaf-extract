<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ShiftFlow.ServiceDefaults\ShiftFlow.ServiceDefaults.csproj" />
    <ProjectReference Include="..\ShiftFlow.Application\ShiftFlow.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- RemoveAllResilienceHandlers es experimental (EXTEXP0001); necesario para cookies login Api. -->
