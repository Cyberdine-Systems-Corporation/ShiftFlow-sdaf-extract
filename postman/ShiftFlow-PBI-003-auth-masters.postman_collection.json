{
  "info": {
    "_postman_id": "shiftflow-pbi-003-auth-masters",
    "name": "ShiftFlow — Auth + Maestros + Calendario (PBI-003…005)",
    "description": "Cookie auth (ShiftFlow.Auth).\n\n1. Ajusta `baseUrl` a la URL HTTPS de la Api en Aspire.\n2. Desactiva verificación SSL en Settings (cert de desarrollo) o confía el certificado.\n3. Ejecuta Login (Postman guarda la cookie sola).\n4. Create Organization → Department → Employee → ShiftType (scripts guardan IDs).\n5. Calendario / Assignments (PBI-005): GetMonthCalendar → AssignShift → solape HR-01 → adyacente → CancelShift.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7xxx" },
    { "key": "organizationId", "value": "" },
    { "key": "departmentId", "value": "" },
    { "key": "employeeId", "value": "" },
    { "key": "shiftTypeId", "value": "" },
    { "key": "assignmentId", "value": "" },
    { "key": "calendarYear", "value": "2026" },
    { "key": "calendarMonth", "value": "8" }
  ],
  "item": [
    {
      "name": "Status",
      "item": [
        {
          "name": "GET status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/status"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"demo.admin\",\n  \"password\": \"ChangeMe!123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "GET me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "POST logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        {
          "name": "POST create organization",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('organizationId', j.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hospital Norte\"\n}"
            },
            "url": "{{baseUrl}}/api/organizations"
          }
        },
        {
          "name": "GET list organizations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/organizations"
          }
        },
        {
          "name": "GET organization by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/organizations/{{organizationId}}"
          }
        },
        {
          "name": "PUT rename organization",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hospital Norte Renombrado\"\n}"
            },
            "url": "{{baseUrl}}/api/organizations/{{organizationId}}/name"
          }
        },
        {
          "name": "PUT set organization active",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/organizations/{{organizationId}}/active"
          }
        }
      ]
    },
